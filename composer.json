{
    "name": "commsy/commsy",
    "description": "A web-based community system",
    "license": "GPLv2",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "0x46616c6b/etherpad-lite-client": "^0.7.0",
        "api-platform/doctrine-orm": "^4.1",
        "api-platform/symfony": "^4.1",
        "composer/package-versions-deprecated": "^1.8",
        "debril/rss-atom-bundle": "^5.2",
        "doctrine/dbal": "^3.8",
        "doctrine/doctrine-bundle": "^2.5",
        "doctrine/doctrine-migrations-bundle": "^3.2",
        "doctrine/orm": "^3.2",
        "eluceo/ical": "^2.5",
        "ezyang/htmlpurifier": "^4.1",
        "friendsofsymfony/ckeditor-bundle": "^2.5",
        "friendsofsymfony/elastica-bundle": "^6.4",
        "galbar/jsonpath": "^3.0",
        "knplabs/knp-menu-bundle": "^3.0",
        "knplabs/knp-paginator-bundle": "^6.2",
        "knplabs/knp-snappy-bundle": "^1.7",
        "lcobucci/jwt": "^5.3",
        "lexik/jwt-authentication-bundle": "^3.1",
        "liip/imagine-bundle": "^2.3",
        "masterminds/html5": "^2.7",
        "mhujer/breadcrumbs-bundle": "^1.5",
        "nelmio/cors-bundle": "^2.2",
        "nette/utils": "^4.0",
        "ozdemirburak/iris": "^3.1",
        "php-imap/php-imap": "^5.0",
        "phpdocumentor/reflection-docblock": "^5.6",
        "phpseclib/phpseclib": "^3.0",
        "phpstan/phpdoc-parser": "^2.0",
        "promphp/prometheus_client_php": "^2.6",
        "sabre/vobject": "^4.3",
        "spiriitlabs/form-filter-bundle": "^12.0",
        "sylius/theme-bundle": "^2.4",
        "symfony/asset": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2.2",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/html-sanitizer": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/ldap": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bundle": "^3.3",
        "symfony/polyfill-apcu": "^1.10",
        "symfony/process": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/scheduler": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/stimulus-bundle": "^2.13",
        "symfony/stopwatch": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/ux-autocomplete": "^2.7",
        "symfony/ux-cropperjs": "^2.26",
        "symfony/ux-live-component": "^2.17",
        "symfony/ux-twig-component": "^2.17",
        "symfony/validator": "7.4.*",
        "symfony/webpack-encore-bundle": "^2.1",
        "symfony/workflow": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfonycasts/dynamic-forms": "^0.1.3",
        "twig/extra-bundle": "^3.8",
        "twig/intl-extra": "^3.8",
        "twig/string-extra": "^3.3",
        "vich/uploader-bundle": "^2.2"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.2",
        "dg/bypass-finals": "^1.8",
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "justinrainbow/json-schema": "^6.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.0",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/maker-bundle": "^1.21",
        "symfony/phpunit-bridge": "^7.2",
        "symfony/web-profiler-bundle": "7.4.*",
        "zenstruck/foundry": "^2.9"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "classmap": [
            "legacy/classes"
        ],
        "files": [
            "legacy/etc/cs_constants.php",
            "legacy/functions/curl_functions.php",
            "legacy/functions/date_functions.php",
            "legacy/functions/language_functions.php",
            "legacy/functions/misc_functions.php",
            "legacy/functions/text_functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "ckeditor:install --clear=drop --tag=4.20.2": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "ckeditor:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "7.4.*"
        }
    }
}
