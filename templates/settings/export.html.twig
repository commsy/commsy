{% extends 'base/settings.html.twig' %}

{% block content %}
    <div class="uk-grid">

        <div class="uk-width-medium-4-4">
            <main id="main-content" aria-labelledby="room-settings-heading">
            <div class="uk-panel uk-panel-box uk-panel-box-primary">
                <div class="uk-panel-teaser cs-panel-teaser-primary">
                    <div class="uk-flex uk-flex-middle uk-flex-space-between">
                        <h2 id="room-settings-heading" class="uk-panel-title">{{ 'Export room content'|trans({}, 'settings') }}</h2>
                    </div>
                </div>

                {% for message in app.flashes('notice') %}
                    <div class="uk-alert uk-alert-warning">{{ message }}</div>
                {% endfor %}

                <div class="uk-margin">
                    {{ 'Export explanation'|trans({}, 'settings') }}
                </div>

                <div class="uk-margin">
                    {% if blockingExport %}
                        <div class="uk-alert">{{ 'Export in progress'|trans({}, 'settings') }}</div>
                    {% else %}
                        <form method="post" action="{{ path('app_settings_exportstart', {'roomId': roomId}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('room_export_start' ~ roomId) }}">
                            <button type="submit" class="uk-button uk-button-primary">{{ 'Start export'|trans({}, 'settings') }}</button>
                        </form>
                    {% endif %}
                </div>

                {% if exports is not empty %}
                    <div class="uk-overflow-container">
                        <table class="uk-table uk-table-striped">
                            <thead>
                                <tr>
                                    <th>{{ 'Requested at'|trans({}, 'settings') }}</th>
                                    <th>{{ 'Requested by'|trans({}, 'settings') }}</th>
                                    <th>{{ 'Status'|trans({}, 'settings') }}</th>
                                    <th>{{ 'Size'|trans({}, 'settings') }}</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for export in exports %}
                                    <tr>
                                        <td>{{ export.requestedAt|date('d.m.Y H:i') }}</td>
                                        <td>{{ export.requestedByName ?? '–' }}</td>
                                        <td>
                                            {{ ('export status ' ~ export.status.value)|trans({}, 'settings') }}
                                            {% if export.failureReason %}
                                                <div class="uk-text-muted uk-text-small">{{ export.failureReason }}</div>
                                            {% elseif export.status.value == 'abandoned' %}
                                                <div class="uk-text-muted uk-text-small">{{ 'export abandoned hint'|trans({}, 'settings') }}</div>
                                            {% endif %}
                                        </td>
                                        <td>{{ export.sizeInBytes ? export.sizeInBytes|file_size : '–' }}</td>
                                        <td>
                                            {% if available[export.id]|default(false) %}
                                                <a class="uk-button uk-button-small" href="{{ path('app_settings_exportdownload', {'roomId': roomId, 'exportId': export.id}) }}">
                                                    {{ 'Download'|trans({}, 'settings') }}
                                                </a>
                                            {% elseif export.status.value == 'finished' %}
                                                <span class="uk-text-muted">{{ 'export expired'|trans({}, 'settings') }}</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
            </main>
        </div>
    </div>
{% endblock %}
