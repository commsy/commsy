{% extends 'base/profile.html.twig' %}

{% block side_navigation %}
    <nav aria-label="{{ 'notifications'|trans({}, 'menu') }}">
    {{ knp_menu_render('account') }}
    </nav>
{% endblock %}

{% block content %}
    {% set panelName = 'notifications' %}
    {% set portalId = app.request.attributes.get('portalId') %}
    <main id="main-content" aria-labelledby="{{ panelName }}-heading">
    {% component 'v2:panel' with { name: panelName, title: 'notifications'|trans({}, 'menu') } %}
        {% block content %}
            {% if notifications is empty %}
                <p class="uk-text-muted">{{ 'noNotifications'|trans({}, 'notification') }}</p>
            {% else %}
                {% if unreadCount > 0 %}
                    <form method="post" action="{{ path('app_notification_read_all', {portalId: portalId}) }}" class="uk-margin-small-bottom">
                        <input type="hidden" name="_token" value="{{ csrf_token('notification_read_all') }}">
                        <button type="submit" class="uk-button uk-button-link">{{ 'markAllRead'|trans({}, 'notification') }}</button>
                    </form>
                {% endif %}
                <ul class="uk-list uk-list-striped">
                    {% for notification in notifications %}
                        <li class="{{ notification.unread ? 'cs-notification-unread' : '' }}">
                            <a href="{{ path('app_notification_open', {portalId: portalId, id: notification.id}) }}">{{ notification.title }}</a>
                            <div class="uk-text-meta">
                                {{ notification.roomTitle }}
                                {%- if notification.actorName %} &middot; {{ notification.actorName }}{% endif -%}
                                &middot; {{ notification.createdAt|date('Y-m-d H:i') }}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        {% endblock %}
    {% endcomponent %}
    </main>
{% endblock content %}
