{% form_theme form 'form/uikit3/uikit_horizontal_layout.html.twig' %}

<div {{ attributes }}>
    <div class="uk-grid">

        <div class="uk-width-1-1">

            {% component 'v3:card' with { title: 'Create new context'|trans({}, "room") } %}

                {% block content %}
                    {{ form_start(form, {
                        attr: {
                            'data-action': 'live#action:prevent',
                            'data-live-action-param': 'save'
                        }
                    }) }}
                        {{ form_errors(form) }}

                        {% if form.type_select is defined %}
                            {{ form_row(form.type_select) }}
                        {% endif %}

                        {% if form.type_sub.generic.title is defined %}
                            {{ form_row(form.type_sub.generic.title) }}
                        {% endif %}

                        {% if form.type_sub.masterTemplate is defined %}
                            {{ form_row(form.type_sub.masterTemplate, {
                                'help': outerScope.this.templateDescription
                            }) }}
                        {% endif %}

                        {% if form.type_sub.communityRooms is defined %}
                            {{ form_row(form.type_sub.communityRooms) }}
                        {% endif %}

                        {% if form.type_sub.createUserRooms is defined %}
                            {{ form_row(form.type_sub.createUserRooms) }}
                        {% endif %}

                        {% if form.type_sub.userroomTemplate is defined %}
                            {{ form_row(form.type_sub.userroomTemplate) }}
                        {% endif %}

                        {% if form.type_sub.timeInterval is defined %}
                            {{ form_row(form.type_sub.timeInterval) }}
                        {% endif %}

                        {% if form.type_sub.generic.categories is defined %}
                            {{ form_row(form.type_sub.generic.categories) }}
                        {% endif %}

                        {% if form.type_sub.generic.language is defined %}
                            {{ form_row(form.type_sub.generic.language) }}
                        {% endif %}

                        {% if form.type_sub.generic.roomDescription is defined %}
                            {{ form_row(form.type_sub.generic.roomDescription) }}
                        {% endif %}

                        {% if form.type_sub.save is defined %}
                            {{ form_row(form.type_sub.save) }}
                        {% endif %}

                        {% if form.type_sub.cancel is defined %}
                            {{ form_row(form.type_sub.cancel, {
                                attr: {
                                    'data-action': 'live#action',
                                    'data-live-action-param': 'cancel',
                                }
                            }) }}
                        {% endif %}

                    {{ form_end(form) }}
                {% endblock %}
            {% endcomponent %}

        </div>
    </div>
</div>
