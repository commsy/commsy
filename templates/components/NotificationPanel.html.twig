<section{{ attributes.defaults({'data-poll': 'delay(60000)|$render'}) }} aria-label="{{ this.title|default('notifications'|trans({}, 'menu')) }}">
    {% component 'v2:panel' with { name: 'room-activity', title: this.title|default('notifications'|trans({}, 'menu')) } %}
        {% block content %}
            {# Inside the panel block `this` is the panel component; `outerScope.this` is the NotificationPanel. #}
            {% set panel = outerScope.this %}
            {# Rubric icons mirror MenuBuilder::getRubricIcon (UIKit 2 / FontAwesome). #}
            {% set rubricIcons = {
                announcement: 'uk-icon-comment-o',
                material: 'uk-icon-file-o',
                date: 'uk-icon-calendar',
                discussion: 'uk-icon-comments-o',
                todo: 'uk-icon-check-square-o',
                group: 'uk-icon-group',
                topic: 'uk-icon-book'
            } %}

            {% if panel.notifications is empty %}
                <p class="uk-text-muted uk-margin-remove">{{ 'noNotifications'|trans({}, 'notification') }}</p>
            {% else %}
                <div class="uk-text-right uk-margin-small-bottom">
                    <a href="#" class="uk-text-muted uk-text-small" data-action="live#action" data-live-action-param="dismissAll">
                        <i class="uk-icon-close uk-margin-small-right"></i>{{ 'dismissAll'|trans({}, 'notification') }}
                    </a>
                </div>
                <ul class="uk-comment-list">
                    {% for notification in panel.notifications %}
                        {% set icon = rubricIcons[notification.sourceItemType]|default('uk-icon-bell-o') %}
                        {% set link = panel.linkFor(notification) %}
                        {% set p = notification.payload %}
                        {% set start = panel.scheduledStart(notification) %}
                        {% set end = panel.scheduledEnd(notification) %}
                        <li>
                            <article class="uk-comment{{ notification.unread ? ' cs-notification-unread' : '' }}" style="position: relative;">
                                {# The rubric icon must stay the first child: article.uk-comment > i:first-child is right-aligned by cs-theme (comment.less). #}
                                <i class="{{ icon }} uk-icon-small {{ notification.unread ? 'uk-text-primary' : 'uk-text-muted' }}"></i>
                                <a href="#" class="uk-text-muted" style="position: absolute; top: 5px; right: 40px; padding: 2px;"
                                   data-action="live#action" data-live-action-param="dismiss" data-live-id-param="{{ notification.id }}"
                                   title="{{ 'dismiss'|trans({}, 'notification') }}">
                                    <i class="uk-icon-close"></i>
                                </a>
                                <header class="uk-comment-header uk-margin-remove uk-flex">
                                    <div class="uk-margin-right uk-flex-item-none">
                                        {% if p.actorId %}
                                            <a href="{{ path('app_user_detail', {'roomId': notification.contextId, 'itemId': p.actorId}) }}">
                                                <img class="uk-thumbnail uk-border-circle cs-comment-thumbnail" style="height:42px; width:42px;"
                                                     src="{{ path('app_user_image', {'roomId': notification.contextId, 'itemId': p.actorId}) }}"
                                                     title="{{ notification.actorName }}" data-uk-tooltip>
                                            </a>
                                        {% else %}
                                            <img class="uk-thumbnail uk-border-circle cs-comment-thumbnail" style="height:42px; width:42px;"
                                                 src="{{ path('app_user_guestimage') }}" title="{{ notification.actorName|default('') }}" data-uk-tooltip>
                                        {% endif %}
                                        <div class="uk-comment-meta">
                                            <span class="uk-text-nowrap">
                                                {% if notification.createdAt|date("d.m.Y") == "now"|date("d.m.Y") %}
                                                    {{ 'today'|trans({})|capitalize }}, {{ notification.createdAt|date("H:i") }}
                                                {% else %}
                                                    {{ notification.createdAt|format_date }}
                                                {% endif %}
                                            </span>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="uk-comment-meta">
                                            <a href="{{ path('app_room_home', {'roomId': notification.contextId}) }}">{{ notification.roomTitle }}</a>
                                        </div>
                                        <h4 class="uk-comment-title uk-margin-remove">
                                            {% if link %}
                                                <a href="{{ link }}"{% if notification.unread %} class="uk-text-bold"{% endif %}>{{ notification.title }}</a>
                                            {% else %}
                                                <span{% if notification.unread %} class="uk-text-bold"{% endif %}>{{ notification.title }}</span>
                                            {% endif %}
                                        </h4>
                                        <div class="uk-comment-meta">
                                            {%- if notification.sourceItemType == 'date' -%}
                                                {% if start %}{{ start|format_date }}{% if not p.wholeDay %}, {{ start|format_time('short') }}{% endif %}{% if end and end != start and not p.wholeDay %} – {{ end|format_time('short') }}{% endif %}{% endif %}
                                                {%- if p.place %}{% if start %}, {% endif %}{{ p.place }}{% endif -%}
                                            {%- elseif notification.sourceItemType == 'material' -%}
                                                {{ 'by'|trans({})|capitalize }}: {{ p.materialAuthor|default(p.creatorName)|default(notification.actorName) }}{% if p.publishingDate %} ({{ p.publishingDate }}){% endif %}
                                            {%- elseif p.creatorName -%}
                                                {{ 'by'|trans({})|capitalize }}: {{ p.creatorName }}
                                            {%- endif -%}
                                            {%- if p.hasAttachments %} <i class="uk-icon-paperclip uk-margin-small-left" title="{{ 'attachments'|trans({}, 'notification') }}" data-uk-tooltip></i>{% endif %}
                                        </div>
                                    </div>
                                </header>
                            </article>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        {% endblock %}
    {% endcomponent %}
</section>
