<section{{ attributes.defaults({'data-poll': 'delay(60000)|$render'}) }} aria-label="{{ this.title|default('notifications'|trans({}, 'menu')) }}">
    {% component 'v2:panel' with { name: 'room-activity', title: this.title|default('notifications'|trans({}, 'menu')) } %}
        {% block teaser_right %}
            {# Inside the panel block `this` is the panel component; `outerScope.this` is the NotificationPanel. #}
            {% if outerScope.this.unreadCount > 0 %}
                {% component 'v2:dropdown' with { icon: 'caret-down', title: 'selected entries'|trans({}, 'rubric')|capitalize } %}
                    {% block dropdown %}
                        <ul class="uk-nav uk-nav-dropdown uk-list-striped">
                            <li>
                                <a href="#" data-action="live#action" data-live-action-param="markAllRead">
                                    <i class="uk-icon-justify uk-icon-small uk-icon-check uk-visible-large"></i> {{ 'markAllRead'|trans({}, 'notification') }}
                                </a>
                            </li>
                        </ul>
                    {% endblock %}
                {% endcomponent %}
            {% endif %}
        {% endblock %}

        {% block content %}
            {# Inside the panel block `this` is the panel component; `outerScope.this` is the NotificationPanel. #}
            {% set panel = outerScope.this %}
            {# Rubric icons mirror MenuBuilder::getRubricIcon (UIKit 2 / FontAwesome). #}
            {% set rubricIcons = {
                announcement: 'uk-icon-comment-o', material: 'uk-icon-file-o', date: 'uk-icon-calendar',
                discussion: 'uk-icon-comments-o', todo: 'uk-icon-check-square-o', group: 'uk-icon-group', topic: 'uk-icon-book'
            } %}
            {% set actionIcons = { created: 'uk-icon-plus-circle', edited: 'uk-icon-pencil', annotated: 'uk-icon-comment' } %}

            {% if panel.groups is empty %}
                <p style="color: #666;" class="uk-margin-remove">{{ 'noNotifications'|trans({}, 'notification') }}</p>
            {% else %}
                <ul class="uk-comment-list">
                    {% for group in panel.groups %}
                        {% set origin = group.origin %}
                        {% set latest = group.latest %}
                        {% set p = latest.payload %}
                        {% set icon = rubricIcons[group.sourceItemType]|default('uk-icon-bell-o') %}
                        {% set link = panel.linkFor(latest) %}
                        {% set start = panel.scheduledStart(latest) %}
                        {% set end = panel.scheduledEnd(latest) %}
                        <li>
                            <article class="uk-comment{{ group.unread ? ' cs-notification-unread' : '' }}" style="position: relative;">
                                {# The rubric icon must stay the first child: article.uk-comment > i:first-child is right-aligned by cs-theme. #}
                                <i class="{{ icon }} uk-icon-small {{ group.unread ? 'uk-text-primary' : 'uk-text-muted' }}"></i>
                                {% if group.indicatorStatus == 'new' %}
                                    <div class="cs-comment-change-info" data-uk-tooltip title="{{ 'newEntry'|trans({}) }}"><i class="uk-icon-medium uk-text-danger uk-icon-exclamation"></i></div>
                                {% elseif group.indicatorStatus == 'changed' %}
                                    <div class="cs-comment-change-info" data-uk-tooltip title="{{ 'changedEntry'|trans({}) }}"><i class="uk-icon-medium uk-text-warning uk-icon-exclamation"></i></div>
                                {% endif %}
                                <header class="uk-comment-header uk-margin-remove uk-flex">
                                    <div class="uk-margin-right uk-flex-item-none">
                                        {% if origin.payload.actorId %}
                                            <a href="{{ path('app_user_detail', {'roomId': group.contextId, 'itemId': origin.payload.actorId}) }}">
                                                {# alt="" marks the avatar decorative: the name is already in the row and in the
                                                   link. It also keeps Firefox from painting a placeholder ring in the link colour
                                                   while it is still deciding what the image is. #}
                                                <img class="uk-thumbnail uk-border-circle cs-comment-thumbnail" style="height:42px; width:42px;" alt=""
                                                     src="{{ path('app_user_image', {'roomId': group.contextId, 'itemId': origin.payload.actorId}) }}"
                                                     title="{{ origin.actorName }}" data-uk-tooltip>
                                            </a>
                                        {% else %}
                                            <img class="uk-thumbnail uk-border-circle cs-comment-thumbnail" style="height:42px; width:42px;" alt=""
                                                 src="{{ path('app_user_guestimage') }}" title="{{ origin.actorName|default('') }}" data-uk-tooltip>
                                        {% endif %}
                                        <div class="uk-comment-meta">
                                            <span class="uk-text-nowrap">
                                                {% if origin.createdAt|date("d.m.Y") == "now"|date("d.m.Y") %}
                                                    {{ 'today'|trans({})|capitalize }}, {{ origin.createdAt|date("H:i") }}
                                                {% else %}
                                                    {{ origin.createdAt|format_date }}
                                                {% endif %}
                                            </span>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="uk-comment-meta">
                                            <a href="{{ path('app_room_home', {'roomId': group.contextId}) }}">{{ group.roomTitle }}</a>
                                        </div>
                                        <h4 class="uk-comment-title uk-margin-remove">
                                            {% if link %}<a href="{{ link }}"{% if group.unread %} class="uk-text-bold"{% endif %}>{{ group.title }}</a>
                                            {% else %}<span{% if group.unread %} class="uk-text-bold"{% endif %}>{{ group.title }}</span>{% endif %}
                                        </h4>
                                        <div class="uk-comment-meta">
                                            {%- if origin.action.value == 'created' -%}
                                                {{ 'createdBy'|trans({'%name%': origin.payload.creatorName|default(origin.actorName)}, 'notification') }}
                                            {%- else -%}
                                                {{ ('action.' ~ origin.action.value)|trans({}, 'notification') }} {{ 'byCreator'|trans({'%name%': origin.actorName}, 'notification') }}
                                            {%- endif -%}
                                            {%- if group.sourceItemType == 'date' and start %} &middot; {{ start|format_date }}{% if not p.wholeDay %}, {{ start|format_time('short') }}{% endif %}{% if end and end != start and not p.wholeDay %} – {{ end|format_time('short') }}{% endif %}{% if p.place %}, {{ p.place }}{% endif %}{% endif %}
                                            {%- if group.sourceItemType == 'material' and p.materialAuthor %} &middot; {{ p.materialAuthor }}{% if p.publishingDate %} ({{ p.publishingDate }}){% endif %}{% endif %}
                                            {%- if p.hasAttachments %} <i class="uk-icon-paperclip uk-margin-small-left" title="{{ 'attachments'|trans({}, 'notification') }}" data-uk-tooltip></i>{% endif %}
                                        </div>
                                        {% if group.events|length > 1 %}
                                            <div class="uk-comment-meta uk-margin-small-top">
                                                {% for event in group.events %}
                                                    <i class="{{ actionIcons[event.action.value]|default('uk-icon-circle-o') }} uk-margin-small-right {{ event.unread ? 'uk-text-primary' : 'uk-text-muted' }}"
                                                       data-uk-tooltip title="{{ ('action.' ~ event.action.value)|trans({}, 'notification') }} · {{ event.actorName }} · {% if event.createdAt|date('d.m.Y') == 'now'|date('d.m.Y') %}{{ 'today'|trans({})|capitalize }}, {{ event.createdAt|date('H:i') }}{% else %}{{ event.createdAt|format_date }}{% endif %}"></i>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </header>
                            </article>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        {% endblock %}
    {% endcomponent %}
</section>
