{% import 'utils/macros.html.twig' as macrosUtils %}

<div {{ attributes.defaults(stimulus_controller('FileList:FileList')) }}>
    <hr class="uk-width-9-10"/>

    <article class="uk-article uk-margin-left uk-margin-right">
        <a id="files"></a>

        {# title row #}
        <div class="uk-grid uk-margin-bottom">
            <div class="uk-width-8-10">
                <h4 class="cs-detail-section-header">
                    {{- "files"|trans({}) }}
                    ({{ files|length }})
                </h4>
            </div>
        </div>

        {# filter #}
        <div class="uk-width-9-10">
            <form class="uk-form">
                <div class="uk-flex uk-flex-wrap">
                    {# file name #}
                    <div class="uk-width-1-2 uk-width-large-1-5">
                        <input type="text" placeholder="{{ 'form.file_name'|trans({}, 'form') }}" data-model="filterFileName"/>
                    </div>

                    {# file extension #}
                    <div class="uk-width-1-2 uk-width-large-1-5">
                        <select data-model="filterFileExtensions">
                            <option value="all">{{ 'form.all_file_extensions'|trans({}, 'form') }}</option>
                            {% for extension in this.getAllFileExtensions %}
                                <option value="{{ extension }}">{{ extension }}</option>
                            {% endfor %}
                        </select>
                    </div>

                </div>
            </form>
        </div>

        {# content #}
        <div class="uk-width-9-10">
            {# image files #}
            {% set imageFiles = this.getFileList(true) %}
            {% if imageFiles is not empty %}
                <div class="uk-margin-top uk-margin-bottom uk-grid uk-grid-small uk-grid-match uk-flex-bottom">
                    {% for file in imageFiles %}
                        <twig:FileList:FileListItem
                            :itemId="itemId"
                            :fileDto="file"
                            :isImage="true"
                            :key="file.fileId" />
                    {% endfor %}

                    {# show a show more toggle if there are more images #}
                    {% if imageLimit and imageCount > constant('App\\Twig\\Components\\FileList\\FileList::INITIAL_IMAGE_THRESHOLD') %}
                        <a data-model="imageLimit" data-value="false" data-action="live#update">{{ 'show all'|trans({}) }}</a>
                    {% endif %}
                </div>
            {% endif %}

            {# other files #}
            {% set otherFiles = this.getFileList(false, true) %}
            {% if otherFiles is not empty %}
                <div class="uk-margin-bottom uk-grid uk-grid-small">
                    {% for file in otherFiles %}
                        <twig:FileList:FileListItem
                            :itemId="itemId"
                            :fileDto="file"
                            :key="file.fileId" />
                    {% endfor %}

                    {# show a show more toggle if there are more files #}
                    {% if fileLimit and fileCount > constant('App\\Twig\\Components\\FileList\\FileList::INITIAL_FILE_THRESHOLD') %}
                        <a data-model="fileLimit" data-value="false" data-action="live#update">{{ 'show all'|trans({}) }}</a>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        <div class="uk-margin toggle_create_upload" data-uk-toggle="{target: '.toggle_create_upload'}">
            <button class="uk-button uk-button-primary">{{ 'form.create_or_upload_file'|trans({}, 'form') }}</button>
        </div>

        {% if is_granted('ITEM_EDIT', itemId) and is_granted('ITEM_FILE_LOCK', itemId) %}
            {# Actions for creating new office documents #}
            <div class="uk-width-9-10 uk-margin toggle_create_upload uk-block uk-block-muted uk-hidden">
                <div class="uk-container uk-flex">
                    {# Create documents #}
                    <div>
                        <span>{{ 'form.create_document.text'|trans({}, 'form') }}</span>
                        <div>
                            <button
                                class="uk-button uk-button-default"
                                {{ live_action('createOfficeFile', {'type': 'word', 'itemId': itemId}) }}
                                data-loading="action(createOfficeFile)|addAttribute(disabled)"
                            >
                                <i class="uk-icon-file-word-o uk-icon-medium"></i>
                            </button>
                            <button
                                class="uk-button uk-button-default"
                                {{ live_action('createOfficeFile', {'type': 'spreadsheet', 'itemId': itemId}) }}
                                data-loading="action(createOfficeFile)|addAttribute(disabled)"
                            >
                                <i class="uk-icon-file-excel-o uk-icon-medium"></i>
                            </button>
                            <button
                                class="uk-button uk-button-default"
                                {{ live_action('createOfficeFile', {'type': 'presentation', 'itemId': itemId}) }}
                                data-loading="action(createOfficeFile)|addAttribute(disabled)"
                            >
                                <i class="uk-icon-file-powerpoint-o uk-icon-medium"></i>
                            </button>
                        </div>
                    </div>

                    {# File upload #}
                    <div class="uk-flex-item-1 uk-margin-left">
                        {{ form_start(form) }}
                        {{ form_row(form.upload) }}
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        {% endif %}
    </article>
</div>
