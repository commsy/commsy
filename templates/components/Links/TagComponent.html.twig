<div {{ attributes }}>
    <hr class="cs-list-divider">
    <h4 class="cs-list-section-header">
        <span class="cs-detail-section-header-background">
            {{ 'hashtags'|trans({}, 'room') }}
            {% if not embedded %}
                <a data-model="editMode"
                   data-value="true"
                   data-action="live#update"
                ><i class="uk-icon-edit"></i></a>
            {% endif %}
        </span>
    </h4>

    <div>
        {% if editMode %}
            {{ form_start(form) }}
            {{ form_row(form.tags) }}
            {{ form_end(form) }}

            {% if not embedded %}
                <div class="uk-margin-top">
                    <button
                        class="uk-button uk-button-primary"
                        {{ live_action('save', { 'fromButton': true }) }}
                    >{{ 'save'|trans({}, 'form') }}</button>

                    <button
                        class="uk-button uk-button-secondary"
                        {{ live_action('cancel') }}
                    >{{ 'cancel'|trans({}, 'form') }}</button>
                </div>
            {% endif %}
        {% else %}
            <div class="uk-grid uk-grid-small" data-uk-grid-margin>
                {% for tag in this.tags %}
                    <span class="uk-text-bold">{{ tag.name }}</span>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
