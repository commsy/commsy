<div {{ attributes }}>
    <hr class="cs-list-divider">

    <h4 class="cs-list-section-header">
        <span class="cs-detail-section-header-background">
            {{ 'Categories'|trans({}, 'category') }}
            {% if not embedded and not editMode %}
                <a {{ live_action('enableEditMode') }}><i class="uk-icon-edit"></i></a>
            {% endif %}
        </span>
    </h4>

    <div>
        {% if editMode %}
            {{ form_start(form) }}
                {% if form.newCategory is defined %}
                    <div class="uk-flex uk-flex-middle uk-margin-small-bottom">
                        <div class="uk-flex-1">
                            {{ form_row(form.newCategory) }}
                        </div>

                        <button
                            type="button"
                            class="uk-button uk-button-small uk-button-primary uk-margin-small-left"
                            {{ live_action('addCategory') }}
                        >{{ 'Create'|trans({}, 'menu') }}</button>
                    </div>
                {% endif %}

                {{ form_errors(form.categories) }}

                {{ render_tree(this.getTree(enum('App\\Utils\\Tree\\TreeMode').CHECKBOXES)) }}
            {{ form_end(form) }}
            {% if not embedded %}
                <div class="uk-margin-top">
                    <button
                        type="button"
                        class="uk-button uk-button-primary"
                        {{ live_action('save', { 'fromButton': true }) }}
                    >{{ 'save'|trans({}, 'form') }}</button>

                    <button
                        type="button"
                        class="uk-button uk-button-secondary"
                        {{ live_action('cancel') }}
                    >{{ 'cancel'|trans({}, 'form') }}</button>
                </div>
            {% endif %}
        {% else %}
            {{ render_tree(this.getTree(enum('App\\Utils\\Tree\\TreeMode').VIEW)) }}
        {% endif %}
    </div>
</div>
