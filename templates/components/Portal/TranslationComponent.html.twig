{% form_theme form 'form/uikit3/uikit_horizontal_layout.html.twig' %}

<div{{ attributes }}>

    {{ form_start(form) }}

        {{ form_row(form.translation) }}

        {% if form.translationDe is defined %}
            {{ form_row(form.translationDe) }}
        {% endif %}

        {% if form.translationEn is defined %}
            {{ form_row(form.translationEn) }}
        {% endif %}

        {% if form.update is defined %}
            {{ form_row(form.update) }}
        {% endif %}

    {{ form_end(form) }}
</div>
