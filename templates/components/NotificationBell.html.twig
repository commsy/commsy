{% set rows %}
    {% if this.alreadyDecided %}
        <li class="uk-nav-header uk-text-muted">{{ 'bell.alreadyDecided'|trans({}, 'notification') }}</li>
    {% endif %}
    {% for notification in this.notifications %}
        {% set p = notification.payload %}
        <li{% if notification.unread %} class="cs-notification-unread"{% endif %}>
            {% if notification.type.value == 'room_join_request' %}
                <div style="padding: 4px 0;">
                    <span style="display: block;{% if notification.unread %} font-weight: 600;{% endif %}">
                        {{ 'bell.joinRequest'|trans({'%name%': notification.title}, 'notification') }}
                    </span>
                    <span class="uk-text-muted uk-text-small" style="display: block;">
                        {{ notification.roomTitle }} &middot; {{ notification.createdAt|format_date }}
                    </span>
                    <span style="display: block; margin-top: 4px;">
                        <a href="#" class="uk-button uk-button-mini uk-button-primary"
                           data-action="live#action" data-live-action-param="accept" data-live-id-param="{{ notification.sourceItemId }}">
                            {{ 'bell.accept'|trans({}, 'notification') }}
                        </a>
                        <a href="#" class="uk-button uk-button-mini"
                           data-action="live#action" data-live-action-param="reject" data-live-id-param="{{ notification.sourceItemId }}">
                            {{ 'bell.reject'|trans({}, 'notification') }}
                        </a>
                        {% if p.actorId %}
                            <a href="{{ path('app_user_detail', {'roomId': notification.contextId, 'itemId': p.actorId}) }}"
                               class="uk-text-muted uk-text-small uk-margin-small-left">{{ 'bell.viewProfile'|trans({}, 'notification') }}</a>
                        {% endif %}
                    </span>
                </div>
            {% else %}
                <a href="{{ path('app_room_home', {'roomId': notification.contextId}) }}">
                    <span style="display: block;{% if notification.unread %} font-weight: 600;{% endif %}">
                        {%- if p.decision == 'rejected' -%}
                            {{ 'bell.decisionRejected'|trans({'%room%': notification.roomTitle}, 'notification') }}
                        {%- else -%}
                            {{ 'bell.decisionAccepted'|trans({'%room%': notification.roomTitle}, 'notification') }}
                        {%- endif -%}
                    </span>
                    <span class="uk-text-muted uk-text-small" style="display: block;">{{ notification.createdAt|format_date }}</span>
                </a>
            {% endif %}
        </li>
    {% else %}
        {% if not this.alreadyDecided %}
            <li class="uk-nav-header">{{ 'noNotifications'|trans({}, 'notification') }}</li>
        {% endif %}
    {% endfor %}
    {% if this.unreadCount > 0 %}
        <li class="uk-nav-divider"></li>
        <li>
            <a href="#" data-action="live#action" data-live-action-param="markAllRead">
                <i class="uk-icon-eye uk-margin-small-right"></i>{{ 'markAllRead'|trans({}, 'notification') }}
            </a>
        </li>
    {% endif %}
{% endset %}

{% if uikit3 %}
    <li{{ attributes.defaults({'data-poll': 'delay(60000)|$render'}) }}>
        <a href="#" title="{{ 'notifications'|trans({}, 'menu') }}">
            <span uk-icon="bell"></span>
            <small id="cs-nav-notification-indicator">{% if this.unreadCount > 0 %}{{ this.unreadCount }}{% endif %}</small>
        </a>
        <div uk-dropdown="mode: click" class="uk-navbar-dropdown">
            <ul class="uk-nav uk-navbar-dropdown-nav">{{ rows }}</ul>
        </div>
    </li>
{% else %}
    <li{{ attributes.defaults({class: 'uk-parent', 'data-uk-dropdown': "{mode:'click'}", 'data-poll': 'delay(60000)|$render'}) }}>
        <a href="#" title="{{ 'notifications'|trans({}, 'menu') }}">
            <i class="uk-icon-bell-o"></i>
            <small id="cs-nav-notification-indicator">{% if this.unreadCount > 0 %}{{ this.unreadCount }}{% endif %}</small>
        </a>
        <div class="uk-dropdown uk-dropdown-navbar uk-dropdown-width-2">
            <ul class="uk-nav uk-nav-navbar">{{ rows }}</ul>
        </div>
    </li>
{% endif %}
