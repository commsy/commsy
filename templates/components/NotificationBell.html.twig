{% if uikit3 %}
    <li{{ attributes.defaults({'data-poll': 'delay(60000)|$render'}) }}>
        <a href="{{ path('app_notification_list', {portalId: this.portalId}) }}" title="{{ 'notifications'|trans({}, 'menu') }}">
            <span uk-icon="bell"></span>
            <small id="cs-nav-notification-indicator">{% if this.unreadCount > 0 %}{{ this.unreadCount }}{% endif %}</small>
        </a>
        <div uk-dropdown="mode: click" class="uk-navbar-dropdown">
            <ul class="uk-nav uk-navbar-dropdown-nav">
                {% for notification in this.latest %}
                    <li{% if notification.unread %} class="cs-notification-unread"{% endif %}>
                        <a href="{{ path('app_notification_open', {portalId: this.portalId, id: notification.id}) }}">{{ notification.title }}</a>
                    </li>
                {% else %}
                    <li class="uk-nav-header">{{ 'noNotifications'|trans({}, 'notification') }}</li>
                {% endfor %}
                <li class="uk-nav-divider"></li>
                <li><a href="{{ path('app_notification_list', {portalId: this.portalId}) }}">{{ 'showAllNotifications'|trans({}, 'notification') }}</a></li>
                {% if this.unreadCount > 0 %}
                    <li><a href="#" data-action="live#action" data-live-action-param="markAllRead">{{ 'markAllRead'|trans({}, 'notification') }}</a></li>
                {% endif %}
            </ul>
        </div>
    </li>
{% else %}
    <li{{ attributes.defaults({class: 'uk-parent', 'data-uk-dropdown': "{mode:'click'}", 'data-poll': 'delay(60000)|$render'}) }}>
        <a href="{{ path('app_notification_list', {portalId: this.portalId}) }}" title="{{ 'notifications'|trans({}, 'menu') }}">
            <i class="uk-icon-bell-o"></i>
            <small id="cs-nav-notification-indicator">{% if this.unreadCount > 0 %}{{ this.unreadCount }}{% endif %}</small>
        </a>
        <div class="uk-dropdown uk-dropdown-navbar">
            <ul class="uk-nav uk-nav-navbar">
                {% for notification in this.latest %}
                    <li{% if notification.unread %} class="cs-notification-unread"{% endif %}>
                        <a href="{{ path('app_notification_open', {portalId: this.portalId, id: notification.id}) }}">{{ notification.title }}</a>
                    </li>
                {% else %}
                    <li class="uk-nav-header">{{ 'noNotifications'|trans({}, 'notification') }}</li>
                {% endfor %}
                <li class="uk-nav-divider"></li>
                <li><a href="{{ path('app_notification_list', {portalId: this.portalId}) }}">{{ 'showAllNotifications'|trans({}, 'notification') }}</a></li>
                {% if this.unreadCount > 0 %}
                    <li><a href="#" data-action="live#action" data-live-action-param="markAllRead">{{ 'markAllRead'|trans({}, 'notification') }}</a></li>
                {% endif %}
            </ul>
        </div>
    </li>
{% endif %}
