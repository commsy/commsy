{% if not uikit3 %}
    <div class="uk-navbar-content">
        <ul class="uk-navbar-nav">
            {% if showPortalConfigurationLink %}
                <li>
                    <a href="{{ path('app_portalsettings_general', { 'portalId': portal.id }) }}" title="{{ 'Portal configuration'|trans({}, 'portal') }}">
                        <i class="uk-icon-justify uk-icon-wrench"></i>
                    </a>
                </li>
            {% endif %}

            {% if supportLink is not empty and tooltip is not empty %}
                <li>
                    <a href="{{ supportLink }}" title="{{ tooltip }}" target="_blank"><i class="uk-icon-question-circle"></i></a>
                </li>
            {% endif %}

            {% if privateRoomItem %}
                <li>
                    <a href="{{ path('app_marked_list', {'roomId': roomId}) }}" title="{{ 'marked'|capitalize|trans({}, "rubric")}}">
                        <i class="uk-icon-bookmark-o"></i>
                        <small id="cs-nav-mark-indicator">
                            {% if count > 0 %}
                                {{ count }}
                            {% endif %}
                        </small>
                    </a>
                </li>

                <li class="uk-parent" data-uk-dropdown="{mode:'click'}">
                    <a href="{{ path('app_notification_list', {'portalId': portal.id}) }}" title="{{ 'notifications'|trans({}, 'menu') }}">
                        <i class="uk-icon-bell-o"></i>
                        <small id="cs-nav-notification-indicator">
                            {% if notificationCount > 0 %}
                                {{ notificationCount }}
                            {% endif %}
                        </small>
                    </a>
                    <div class="uk-dropdown uk-dropdown-navbar">
                        <ul class="uk-nav uk-nav-navbar">
                            {% for notification in latestNotifications %}
                                <li{% if notification.unread %} class="cs-notification-unread"{% endif %}>
                                    <a href="{{ path('app_notification_open', {'portalId': portal.id, 'id': notification.id}) }}">{{ notification.title }}</a>
                                </li>
                            {% else %}
                                <li class="uk-nav-header">{{ 'noNotifications'|trans({}, 'notification') }}</li>
                            {% endfor %}
                            <li class="uk-nav-divider"></li>
                            <li><a href="{{ path('app_notification_list', {'portalId': portal.id}) }}">{{ 'showAllNotifications'|trans({}, 'notification') }}</a></li>
                            {% if notificationCount > 0 %}
                                <li>
                                    <form method="post" action="{{ path('app_notification_read_all', {'portalId': portal.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('notification_read_all') }}">
                                        <button type="submit" class="uk-button uk-button-link">{{ 'markAllRead'|trans({}, 'notification') }}</button>
                                    </form>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </li>

                <li>
                    <a href="{{ path('app_material_list', {'roomId': privateRoomItem.itemId}) }}" title="{{ 'stackStatus'|trans({}, "profile")}}">
                        <i class="uk-icon-folder-open-o"></i>
                    </a>
                </li>

                <li>
                    <a href="{{ path('app_dashboard_overview', {'roomId': privateRoomItem.itemId}) }}" title="{{ 'dashboard'|trans({}, "rubric")}}">
                        <i class="uk-icon-qrcode"></i>
                    </a>
                </li>
            {% endif %}
        </ul>
    </div>
{% else %}
    {% if showPortalConfigurationLink %}
        <li>
            <a href="{{ path('app_portalsettings_general', { 'portalId': portal.id }) }}" title="{{ 'Portal configuration'|trans({}, 'portal') }}">
                <i class="uk-icon-justify uk-icon-wrench"></i>
            </a>
        </li>
    {% endif %}

    {% if supportLink is not empty and tooltip is not empty %}
        <li>
            <a href="{{ supportLink }}" title="{{ tooltip }}" target="_blank" uk-icon="icon: question"></a>
        </li>
    {% endif %}

    {% if privateRoomItem %}
        <li>
            <a href="{{ path('app_marked_list', {'roomId': privateRoomItem.itemId}) }}" title="{{ 'marked'|capitalize|trans({}, "rubric")}}">
                <span uk-icon="check"></span>
                <small id="cs-nav-mark-indicator">
                    {% if count > 0 %}
                        {{ count }}
                    {% endif %}
                </small>
            </a>
        </li>

        <li>
            <a href="{{ path('app_notification_list', {'portalId': portal.id}) }}" title="{{ 'notifications'|trans({}, 'menu') }}">
                <span uk-icon="bell"></span>
                <small id="cs-nav-notification-indicator">
                    {% if notificationCount > 0 %}
                        {{ notificationCount }}
                    {% endif %}
                </small>
            </a>
            <div uk-dropdown="mode: click" class="uk-navbar-dropdown">
                <ul class="uk-nav uk-navbar-dropdown-nav">
                    {% for notification in latestNotifications %}
                        <li{% if notification.unread %} class="cs-notification-unread"{% endif %}>
                            <a href="{{ path('app_notification_open', {'portalId': portal.id, 'id': notification.id}) }}">{{ notification.title }}</a>
                        </li>
                    {% else %}
                        <li class="uk-nav-header">{{ 'noNotifications'|trans({}, 'notification') }}</li>
                    {% endfor %}
                    <li class="uk-nav-divider"></li>
                    <li><a href="{{ path('app_notification_list', {'portalId': portal.id}) }}">{{ 'showAllNotifications'|trans({}, 'notification') }}</a></li>
                    {% if notificationCount > 0 %}
                        <li>
                            <form method="post" action="{{ path('app_notification_read_all', {'portalId': portal.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('notification_read_all') }}">
                                <button type="submit" class="uk-button uk-button-link">{{ 'markAllRead'|trans({}, 'notification') }}</button>
                            </form>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </li>

        <li>
            <a href="{{ path('app_material_list', {'roomId': privateRoomItem.itemId}) }}" title="{{ 'stackStatus'|trans({}, "profile")}}" uk-icon="folder"></a>
        </li>

        <li>
            <a href="{{ path('app_dashboard_overview', {'roomId': privateRoomItem.itemId}) }}" title="{{ 'dashboard'|trans({}, "rubric")}}" uk-icon="world"></a>
        </li>
    {% endif %}
{% endif %}
